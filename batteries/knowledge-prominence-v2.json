{
 "name": "knowledge-prominence-v2",
 "built": "2026-07-26",
 "n": 296,
 "supersedes": {
  "name": "knowledge-prominence-v1",
  "why": "v1's book stratum was 64% malformed \u2014 subcategory traversal pulled 'Fictional characters in ...' categories under the novel seeds, so 51 of 80 entries were characters, not books, producing questions like 'Who wrote the book Hannibal Lecter?'. v2 filters subcategories by name before traversing: 2 of 52 remain, and both (Jane Eyre, Tess of the d'Urbervilles) are genuine novel titles that are also character names."
 },
 "design": "Both classes REAL. label 0 = high en.wikipedia pageviews (the model plausibly learned it), label 1 = low pageviews from the SAME Wikipedia category (it plausibly did not). Matched inside the pair on category, last-word initial and name length. Domains: book 26, firm 32, painting 10, person 40, place 40 pairs.",
 "label_source": "en.wikipedia pageviews \u2014 external to our model and our retriever",
 "surface_floor": {
  "tool": "nulltest",
  "permutations": 600,
  "as_this_file_scores": {
   "verdict": "PASS",
   "worst_cell": "lexicality/place",
   "worst_a_star": 0.689,
   "family_adjusted_p": 0.0982,
   "cells": 15,
   "what_it_scores": "the bare entity names in this file \u2014 this is what you get running nulltest on it directly"
  },
  "as_the_model_sees_it": {
   "verdict": "PASS",
   "worst_cell": "length/place",
   "worst_a_star": 0.655,
   "family_adjusted_p": 0.3028,
   "cells": 14,
   "what_it_scores": "the full question text the console sends ('Who wrote the book X?'), which is the string a model actually receives"
  },
  "why_both_are_published": "They differ \u2014 0.689 against 0.655 \u2014 and quoting only the friendlier one would be the exact defect this instrument exists to catch. A stranger running nulltest on this artifact gets 0.689; the console's battery is scored at 0.655. Both PASS.",
  "power": "n=296; an artifact must cover ~60% of the label-1 half before this test catches it"
 },
 "note_on_dropping_strata": "Removing the 10-pair painting stratum makes the verdict WORSE, not better (worst A* 0.731, adj p 0.0899 over 11 cells): a smaller family makes Westfall-Young min-p less forgiving. Kept all five.",
